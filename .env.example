# ==============================================================================
# Referral Service 环境变量配置示例 (唯一配置源，原则 21/23/24)
# ==============================================================================

# New API 访问配置
NEWAPI_BASE_URL=http://new-api:3000
NEWAPI_ACCESS_TOKEN=your_admin_personal_access_token_here

# 独立 MySQL 数据库连接串 (原则 17、36：禁止直接连接 New API 库，使用独立 referral 库)
MYSQL_DSN=root:your_mysql_password@tcp(mysql:3306)/referral?charset=utf8mb4&parseTime=True&loc=Local

# 返佣比例 (例如 0.10 表示 10%，支持高精度小数，原则 10)
COMMISSION_RATE=0.10

# 订单轮询与性能配置
POLL_INTERVAL_SECONDS=15
TOPUP_PAGE_SIZE=50
HTTP_TIMEOUT_SECONDS=10
RETRY_MAX_ATTEMPTS=3

# 服务监听地址与端口
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# 日志级别 (debug, info, warn, error)
LOG_LEVEL=info

# 日志与审计自动清理保留天数 (原则 34)
# 注意：referral_orders 与 service_runs 永久保存，禁止自动清理
SYSTEM_LOG_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=180
